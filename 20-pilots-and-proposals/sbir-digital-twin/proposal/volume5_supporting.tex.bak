\subsection{Education}

\begin{itemize}
\item \textbf{M.S., Data Science in Artificial Intelligence}, Northwestern University, Evanston, IL.
\item \textbf{B.S., Statistical Science (Actuarial Science)}, University of California, Santa Barbara.
