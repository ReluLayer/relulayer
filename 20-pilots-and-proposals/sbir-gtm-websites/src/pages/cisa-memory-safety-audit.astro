---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'CISA Memory-Safety Audit & C-to-Rust Refactoring for Defense Contractors';
const description = 'Dual-use CISA/ONCD memory-safety audits, C-to-Rust refactoring, and #![no_std] embedded safety kernels for defense primes and commercial robotics OEMs.';
const canonical = 'https://atelierlogicgroup.com/cisa-memory-safety-audit/';

const keywords = [
  'CISA memory safety audit defense contractor',
  'C to Rust refactoring flight software',
  'ONCD memory safe roadmap CISA compliance',
  'no_std Rust embedded safety kernel',
  'Secure by Design memory safety roadmap defense',
];

const deliverables = [
  {
    title: 'Legacy C/C++ Memory-Safety Gap Analysis',
    body: 'We map every unsafe pointer, buffer overflow, use-after-free, and data race surface in your flight-critical code, then rank findings by exploitability and certification impact.',
  },
  {
    title: 'AI-Assisted C-to-Rust Refactoring',
    body: 'Guided migration to idiomatic #![no_std] Rust replaces UB-laden pointer logic with deterministic, formally reviewable code and optional Kani proofs.',
  },
  {
    title: 'CISA / ONCD Roadmap Document',
    body: 'Receive a prioritized, auditor-ready Memory Safety Roadmap aligned to White House ONCD, CISA, and NSA directives with milestones and evidence artifacts.',
  },
  {
    title: 'Drop-in ReluLayer™ Safety Kernel',
    body: 'Close residual unsafe paths with a 326-byte bare-metal Rust micro-kernel that guarantees zero dynamic heap allocation and 128-cycle / 267-ns WCET.',
  },
];
---

<BaseLayout pageType="corporate" title={title} description={description} canonical={canonical}>
  <section class="relative overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28 lg:pt-32 lg:pb-36">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(245,158,11,0.12),_transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(51,65,85,0.25),_transparent_50%)]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-gold/30 bg-gold/10 px-4 py-1.5">
          <span class="flex h-2 w-2 rounded-full bg-gold animate-pulse-gold"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-gold">CISA / ONCD / NSA Aligned</span>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-cream sm:text-5xl md:text-6xl text-balance">
          CISA Memory-Safety Audit &amp; C-to-Rust Refactoring for Defense Contractors
        </h1>

        <p class="mt-6 max-w-3xl text-lg text-slate-300 sm:text-xl md:text-2xl">
          Turnkey memory-safety assessments, AI-assisted refactoring, and
          <code class="rounded bg-slate-800/90 px-1.5 py-0.5 font-mono text-gold">#![no_std]</code>
          embedded kernels that help defense primes and robotics OEMs satisfy CISA, ONCD, and NSA directives.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href="https://atelierlogicgroup.com/#sblo-form" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="M9 12l2 2 4-4" />
            </svg>
            Request CISA Audit &amp; SDK Briefing
          </a>
          <a href="https://atelierlogicgroup.com/capability-statement/" class="btn-secondary">
            View Capability Statement
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-slate-900/50 border-y border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">Why Defense Primes Need a Memory-Safety Roadmap Now</h2>
        <p class="mt-4 section-subheading">
          60%–75% of critical CVEs exploited by nation-state actors originate in C/C++ memory-safety flaws. The White House ONCD, CISA, and NSA have issued explicit directives to migrate safety-critical systems to memory-safe languages.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {deliverables.map((item) => (
          <article class="rounded-2xl border border-slate-400/10 bg-slate-800/30 p-6">
            <h3 class="text-lg font-bold text-cream">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-300">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">Target Keywords &amp; Search Intent</h2>
        <p class="mt-4 section-subheading">
          This page is engineered for high-intent procurement and compliance searches.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {keywords.map((kw) => (
          <span class="technical-badge">{kw}</span>
        ))}
      </div>

      <div class="mt-14 rounded-2xl border border-gold/20 bg-gold/5 p-8 sm:p-12">
        <h3 class="text-2xl font-bold text-cream">Ready for a CISA-Aligned Memory-Safety Audit?</h3>
        <p class="mt-4 text-lg text-slate-300">
          Schedule a technical evaluation with Principal Investigator Ishmael Ibrahim Amin, M.S. to assess legacy C/C++ risk, build a CISA Memory Safety Roadmap, and review the ReluLayer™ <code class="font-mono text-gold">#![no_std]</code> SDK.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href="mailto:proposals@atelierlogicgroup.com" class="btn-primary">
            Email proposals@atelierlogicgroup.com
          </a>
          <a href="https://relulayer.ai/" class="btn-secondary">
            Explore ReluLayer™ Product
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
