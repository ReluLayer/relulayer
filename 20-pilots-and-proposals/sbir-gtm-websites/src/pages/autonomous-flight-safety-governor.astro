---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Autonomous Drone & UAS AI Safety Governor | Runtime Assurance in 0.199 µs';
const description = 'Dual-use deterministic AI safety kernel for defense UAS, commercial BVLOS drones, and autonomous robotics with runtime assurance and 0.199 microsecond interdiction.';
const canonical = 'https://atelierlogicgroup.com/autonomous-flight-safety-governor/';

const keywords = [
  'autonomous drone runaway AI guardrail',
  'deterministic AI safety kernel aerospace',
  'runtime assurance Simplex architecture Pixhawk',
  'Control Barrier Function embedded safety filter',
  'sub-microsecond AI interdiction UAS',
];

const useCases = [
  {
    title: 'Runaway AI Interdiction',
    body: 'When a client neural network or guidance loop issues an unsafe command, ReluLayer™ clamps the vector to the safe flight envelope in 0.199 µs—before actuators move.',
  },
  {
    title: 'Simplex / Runtime Assurance Architecture',
    body: 'Use ReluLayer™ as a high-assurance decision module in a Simplex-style architecture: the complex AI controller proposes, the governor approves or projects.',
  },
  {
    title: 'Control Barrier Function Equivalent',
    body: 'ReluLayer™ implements active-set polyhedral projection that enforces forward-invariant safety sets equivalent to CBF guarantees, without requiring online optimization.',
  },
  {
    title: 'Pixhawk & ARM Cortex-M7 Ready',
    body: 'The 326-byte kernel runs bare-metal on STM32H7 and other ARM Cortex-M7 class flight controllers with deterministic 0.199 µs WCET.'
  },
];
---

<BaseLayout pageType="corporate" title={title} description={description} canonical={canonical}>
  <section class="relative overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28 lg:pt-32 lg:pb-36">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(245,158,11,0.12),_transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(51,65,85,0.25),_transparent_50%)]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-gold/30 bg-gold/10 px-4 py-1.5">
          <span class="flex h-2 w-2 rounded-full bg-gold animate-pulse-gold"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-gold">Runtime Assurance · Simplex · CBF-Equivalent</span>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-cream sm:text-5xl md:text-6xl text-balance">
          Autonomous Drone &amp; UAS AI Safety Governor
        </h1>

        <p class="mt-6 max-w-3xl text-lg text-slate-300 sm:text-xl md:text-2xl">
          A deterministic, bare-metal
          <code class="rounded bg-slate-800/90 px-1.5 py-0.5 font-mono text-gold">#![no_std]</code>
          Rust safety kernel that interdicts rogue AI commands in 0.199 microseconds for drones, UAS, and autonomous robotics.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href="https://atelierlogicgroup.com/#sblo-form" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="M9 12l2 2 4-4" />
            </svg>
            Request CISA Audit & SDK Briefing
          </a>
          <a href="https://relulayer.ai/" class="btn-secondary">
            View Technical Specs
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-slate-900/50 border-y border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">How ReluLayer™ Protects Autonomous Flight</h2>
        <p class="mt-4 section-subheading">
          ReluLayer™ sits between the client AI flight controller and the actuator layer, mathematically enforcing that every output vector remains inside the certifiable flight envelope.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {useCases.map((item) => (
          <article class="rounded-2xl border border-slate-400/10 bg-slate-800/30 p-6">
            <h3 class="text-lg font-bold text-cream">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-300">{item.body}</p>
          </article>
        ))}
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-gold/20 bg-gold/5 p-6 text-center">
          <p class="text-3xl font-black text-gold">0.199 µs</p>
          <p class="mt-2 text-xs font-bold uppercase tracking-wider text-slate-400">Worst-Case Interdiction</p>
        </div>
        <div class="rounded-2xl border border-gold/20 bg-gold/5 p-6 text-center">
          <p class="text-3xl font-black text-gold">~5,000x</p>
          <p class="mt-2 text-xs font-bold uppercase tracking-wider text-slate-400">Faster than Cloud Watchdogs</p>
        </div>
        <div class="rounded-2xl border border-gold/20 bg-gold/5 p-6 text-center">
          <p class="text-3xl font-black text-gold">326 B</p>
          <p class="mt-2 text-xs font-bold uppercase tracking-wider text-slate-400">Core Footprint</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">Target Search Intent</h2>
        <p class="mt-4 section-subheading">
          Engineered for OEMs, autonomy leads, and DEVCOM / PEO Aviation evaluators searching for hardware-level AI safety.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {keywords.map((kw) => (
          <span class="technical-badge">{kw}</span>
        ))}
      </div>

      <div class="mt-14 rounded-2xl border border-gold/20 bg-gold/5 p-8 sm:p-12">
        <h3 class="text-2xl font-bold text-cream">License ReluLayer™ for Your UAS Platform</h3>
        <p class="mt-4 text-lg text-slate-300">
          Schedule a technical evaluation with Atelier Logic Group LLC to receive architecture diagrams, timing traces, and integration guidance for Pixhawk-class flight controllers.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href="mailto:solutions@relulayer.ai" class="btn-primary">
            Email solutions@relulayer.ai
          </a>
          <a href="https://atelierlogicgroup.com/capability-statement/" class="btn-secondary">
            View Capability Statement
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
