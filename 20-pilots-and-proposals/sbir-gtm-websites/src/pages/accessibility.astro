---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Accessibility Statement';
const description = 'Accessibility commitment and conformance targets for Atelier Logic Group LLC dba ReluLayer™ websites.';
const canonical = 'https://atelierlogicgroup.com/accessibility/';
---

<BaseLayout pageType="corporate" title={title} description={description} canonical={canonical}>
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <article class="legal-document">
        <h1>Accessibility Statement</h1>
        <p><strong>Effective Date:</strong> August 26, 2026</p>

        <p>
          Atelier Logic Group LLC dba ReluLayer™ is committed to ensuring that our websites are accessible to everyone, including people with disabilities. We aim to meet or exceed the Web Content Accessibility Guidelines (WCAG) 2.1 Level AA success criteria, and we design our content with U.S. federal and international procurement standards in mind.
        </p>

        <h2>Conformance Targets</h2>
        <ul>
          <li><strong>WCAG 2.1 Level AA</strong> — the baseline for ADA Title III and state anti-discrimination compliance.</li>
          <li><strong>U.S. Section 508 of the Rehabilitation Act</strong> — for federal and defense procurement audiences.</li>
          <li><strong>EN 301 549</strong> — the European standard referenced by the EU Web Accessibility Directive and European Accessibility Act.</li>
        </ul>

        <h2>What We Do</h2>
        <ul>
          <li>Use semantic HTML and ARIA landmarks so pages work with screen readers and keyboard navigation.</li>
          <li>Provide skip links to bypass repetitive navigation.</li>
          <li>Associate all form labels programmatically with their inputs.</li>
          <li>Honor <code>prefers-reduced-motion</code> for users who choose to minimize animation.</li>
          <li>Maintain color-contrast ratios that meet WCAG 2.1 AA thresholds for text and interactive elements.</li>
          <li>Test keyboard operability across navigation, forms, and interactive demos.</li>
        </ul>

        <h2>Known Limitations</h2>
        <p>
          Some interactive technical demonstrations use SVG graphics and animation to illustrate deterministic safety concepts. These demos include text alternatives, aria-labels, and reduced-motion fallbacks, but may still present challenges for some assistive technologies. We continue to improve these experiences and welcome feedback.
        </p>

        <h2>Third-Party Content</h2>
        <p>
          Our websites may link to third-party documents, partner sites, or government systems that are outside our control. We encourage those providers to maintain accessible experiences and are happy to route feedback to them when appropriate.
        </p>

        <h2>Feedback and Assistance</h2>
        <p>
          If you encounter an accessibility barrier or need assistance accessing any content, please contact us. We will make reasonable efforts to provide the information in an accessible format.
        </p>
        <p>
          Email: <a href="mailto:legal@atelierlogicgroup.com?subject=Accessibility%20Feedback">legal@atelierlogicgroup.com</a>
        </p>
        <p>
          Postal mail:<br />
          Atelier Logic Group LLC<br />
          32 Normandy Dr., Kenner, LA 70065
        </p>

        <h2>Assessment and Verification</h2>
        <p>
          We validate our builds with automated accessibility checks and manual keyboard testing. If you believe a page does not meet our stated conformance targets, please let us know and we will investigate promptly.
        </p>
      </article>
      <div class="mt-10">
        <a href="https://atelierlogicgroup.com/" class="btn-secondary">← Back to Corporate Hub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .legal-document h1 { @apply text-3xl font-bold text-cream mb-6; }
  .legal-document h2 { @apply text-xl font-semibold text-gold mt-8 mb-4; }
  .legal-document p { @apply text-slate-300 leading-relaxed mb-4; }
  .legal-document ul { @apply list-disc list-inside text-slate-300 mb-4 space-y-2; }
  .legal-document a { @apply text-amber-400 hover:underline; }
  .legal-document strong { @apply text-cream font-semibold; }
  .legal-document code { @apply text-gold font-mono text-sm bg-slate-800 px-1 py-0.5 rounded; }
</style>
