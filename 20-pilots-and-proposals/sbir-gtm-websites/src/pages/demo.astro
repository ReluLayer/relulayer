---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'ReluLayer™ Product Demo — Deterministic Safety Governors';
const description = 'Interactive product demo for ReluLayer™: a bare-metal #![no_std] Rust Orchestrator engine with 0.199 µs WCET, zero dynamic heap allocation, and CISA memory-safety compliance for defense autonomy and federal Healthcare IT.';
const canonical = 'https://atelierlogicgroup.com/demo/';

const benchmarks = [
  { value: '0.199 µs', label: 'Worst-Case Execution Time', detail: 'Sub-microsecond deterministic clipping' },
  { value: '0 Bytes', label: 'Dynamic Heap Allocation', detail: '_sbrk returns ENOMEM' },
  { value: '0.00%', label: 'HIL Violation Rate', detail: '5,000+ stress passes' },
  { value: '326 B', label: 'Core Kernel Footprint', detail: 'Bare-metal ARM Cortex-M7' },
];

const demos = [
  {
    title: 'Swarm-vs-Swarm Interdiction',
    body: 'A smaller friendly swarm loses all RF and SATCOM links during a contested EW encounter. ACCSE™ executes decentralized cut-node search and Hungarian target allocation while ReluLayer™ enforces kinetic boundaries locally on every node.',
    tags: ['ACCSE™', 'Decentralized', 'Zero C2'],
  },
  {
    title: 'Actuator Memory Firewall',
    body: 'An unsafe PWM command (2500 µs) arrives at the flight controller. The ReluLayer™ kernel clamps the output to the certified envelope (1900 µs) in a single deterministic pass with no heap allocation and no undefined behavior.',
    tags: ['#![no_std] Rust', 'WCET', 'C ABI'],
  },
  {
    title: 'CISA Memory-Safe Refactoring',
    body: 'Legacy C/C++ flight-control loops are refactored into idiomatic #![no_std] Rust. Buffer overflow, use-after-free, and dynamic-memory exhaustion attack surface classes are removed at compile time.',
    tags: ['C-to-Rust', 'Kani', 'Supply Chain'],
  },
];

const verticals = [
  'Tactical UAS & Counter-Swarm',
  'Federal Healthcare IT & FHIR/HL7 Interop',
  'Automotive Steer-by-Wire (ASIL-D)',
  'Wide-Bandgap Power Inverters',
  'Precision CNC & Industrial Robotics',
  'DO-178C Avionics Certification Support',
];
---

<BaseLayout title={title} description={description} canonical={canonical} pageType="product">
  {/* Hero */}
  <section class="relative overflow-hidden bg-navy pt-16 pb-20 sm:pt-24 sm:pb-28 lg:pt-32 lg:pb-36">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(245,158,11,0.12),_transparent_55%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(16,185,129,0.08),_transparent_50%)]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-gold/30 bg-gold/10 px-4 py-1.5">
          <span class="flex h-2 w-2 rounded-full bg-gold animate-pulse-gold"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-gold">Interactive Product Demo</span>
        </div>

        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-cream sm:text-5xl md:text-6xl leading-[1.25] sm:leading-[1.15] text-balance">
          See ReluLayer™ Enforce Safety in Sub-Microseconds
        </h1>

        <p class="mt-6 max-w-3xl text-lg text-slate-300 sm:text-xl md:text-2xl">
          A deterministic, bare-metal <code class="rounded bg-slate-800/90 px-1.5 py-0.5 font-mono text-gold">#![no_std]</code> Rust safety kernel that turns unsafe client-AI commands into certifiable actuator outputs before the next clock tick.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href="https://atelierlogicgroup.com/#sblo-form" class="btn-primary">
            Request a Live Technical Brief
          </a>
          <a href="https://atelierlogicgroup.com/capability-statement/" class="btn-secondary">
            View Capability Statement
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Benchmarks */}
  <section class="py-16 sm:py-20 bg-slate-900/50 border-y border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">Verified Hardware Benchmarks</h2>
        <p class="mt-4 section-subheading">
          Every number below is measured on ARM Cortex-M7 / STM32H7 class silicon at 480 MHz, validated by LSU aiR Lab HIL testing.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {benchmarks.map((item) => (
          <div class="rounded-2xl border border-gold/20 bg-gold/5 p-6 text-center transition-all hover:border-gold/40">
            <p class="text-3xl sm:text-4xl font-black font-mono text-gold">{item.value}</p>
            <p class="mt-2 text-sm font-semibold text-cream">{item.label}</p>
            <p class="mt-1 text-xs text-slate-400">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Demo Scenarios */}
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">Live Demo Scenarios</h2>
        <p class="mt-4 section-subheading">
          Three representative missions showing how ReluLayer™ and ACCSE™ maintain safety under total RF denial, corrupted actuator commands, and legacy-code migration.
        </p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {demos.map((demo) => (
          <article class="rounded-2xl border border-slate-400/10 bg-slate-800/30 p-6 sm:p-8 transition-all hover:border-gold/30 hover:bg-slate-800/50">
            <h3 class="text-xl font-bold text-cream">{demo.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-slate-300">{demo.body}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {demo.tags.map((tag) => (
                <span class="technical-badge">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Target Verticals */}
  <section class="py-16 sm:py-20 bg-slate-900/50 border-y border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div class="max-w-3xl">
          <h2 class="section-heading">Built for Mission-Critical Verticals</h2>
          <p class="mt-4 section-subheading">
            ReluLayer™ brings deterministic, memory-safe envelope enforcement to every domain where physical safety and statutory compliance are non-negotiable.
          </p>
        </div>
        <ul class="space-y-4">
          {verticals.map((v) => (
            <li class="flex items-center gap-3 rounded-xl border border-slate-400/10 bg-slate-800/30 p-4">
              <span class="h-2 w-2 rounded-full bg-gold" aria-hidden="true"></span>
              <span class="text-sm font-semibold text-cream">{v}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-gold/20 bg-gold/5 p-8 sm:p-12 lg:p-16">
        <div class="max-w-3xl">
          <h2 class="section-heading">Ready for a Hands-On Evaluation?</h2>
          <p class="mt-4 text-lg text-slate-300">
            Atelier Logic Group LLC provides architecture diagrams, timing traces, HIL datasets, and integration guidance for defense primes, OEMs, and qualified evaluators.
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a href="mailto:solutions@relulayer.ai" class="btn-primary">
              Email solutions@relulayer.ai
            </a>
            <a href="https://relulayer.ai/" class="btn-secondary">
              Visit Product Hub
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
