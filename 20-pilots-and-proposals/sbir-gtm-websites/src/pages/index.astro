---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroStudio from '../components/sections/HeroStudio.astro';
import EnterpriseModernization from '../components/sections/EnterpriseModernization.astro';
import CapabilityGrid from '../components/sections/CapabilityGrid.astro';
import LeadershipSection from '../components/sections/LeadershipSection.astro';
import SbloLeadForm from '../components/islands/SbloLeadForm';

const title = 'Atelier Logic Group — Deep-Tech R&D Studio & Enterprise AI Advisory';
const description = 'Atelier Logic Group provides enterprise optimization, MILP supply chain solvers, legacy-to-Rust refactoring, Databricks integrations, and agentic AI (MCP, DSPy) architecture.';
const canonical = 'https://atelierlogicgroup.com';
---

<BaseLayout title={title} description={description} canonical={canonical} pageType="corporate">
  <HeroStudio />

  <EnterpriseModernization />

  <CapabilityGrid />

  <LeadershipSection />

  {/* Contact & Lead Capture Portal */}
  <section id="sblo-form" class="py-16 bg-slate-950 border-t border-slate-800">
    <SbloLeadForm client:load />
  </section>

</BaseLayout>