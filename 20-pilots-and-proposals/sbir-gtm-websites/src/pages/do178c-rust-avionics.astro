---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'DO-178C DAL A Rust Safety Library & Avionics Certification Support';
const description = 'Dual-use DO-178C DAL A aligned #![no_std] Rust safety library and deterministic flight governor for defense and commercial avionics certification support.';
const canonical = 'https://atelierlogicgroup.com/do178c-rust-avionics/';

const keywords = [
  'DO-178C DAL A Rust safety library',
  'MIL-STD-882E hazard mitigation autonomous software',
  'worst case execution time 0.199 microseconds ARM Cortex-M7',
  'STM32H7 deterministic flight safety governor',
];

const artifacts = [
  {
    title: 'DO-178C DAL A Process Alignment',
    body: 'We map ReluLayer™ requirements, design, code, and verification activities to RTCA DO-178C software level A objectives, producing traceable evidence for certification authorities.',
  },
  {
    title: 'MIL-STD-882E Hazard Mitigation',
    body: 'Systematic hazard analysis and severity classification inform the safety-set design, ensuring the kernel mitigves catastrophic and critical failure modes.',
  },
  {
    title: 'Worst-Case Execution Time Evidence',
    body: '0.199 µs WCET is measured on ARM Cortex-M7 (STM32H7) at 480 MHz with cycle-accurate instrumentation and bounded loop analysis.',
  },
  {
    title: 'Deterministic Safety Library',
    body: 'A #![no_std], zero-heap Rust library with no dynamic allocation, no panics, and no undefined behavior paths—ideal for certifiable avionics software.',
  },
];
---

<BaseLayout pageType="corporate" title={title} description={description} canonical={canonical}>
  <section class="relative overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28 lg:pt-32 lg:pb-36">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(245,158,11,0.12),_transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(51,65,85,0.25),_transparent_50%)]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-gold/30 bg-gold/10 px-4 py-1.5">
          <span class="flex h-2 w-2 rounded-full bg-gold animate-pulse-gold"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-gold">DO-178C · MIL-STD-882E · WCET Traceable</span>
        </div>

        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-cream sm:text-5xl md:text-6xl text-balance">
          DO-178C DAL A Rust Safety Library &amp; Avionics Certification Support
        </h1>

        <p class="mt-6 max-w-3xl text-lg text-slate-300 sm:text-xl md:text-2xl">
          Certification-aligned
          <code class="rounded bg-slate-800/90 px-1.5 py-0.5 font-mono text-gold">#![no_std]</code>
          Rust safety library and deterministic flight governor for avionics airworthiness and defense contracting due diligence.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href="https://atelierlogicgroup.com/#sblo-form" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="M9 12l2 2 4-4" />
            </svg>
            Request CISA Audit & SDK Briefing
          </a>
          <a href="https://atelierlogicgroup.com/capability-statement/" class="btn-secondary">
            View Capability Statement
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24 bg-slate-900/50 border-y border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">Certification Artifacts &amp; Evidence</h2>
        <p class="mt-4 section-subheading">
          ReluLayer™ is designed to produce the evidence artifacts that FAA DERs, airworthiness release leads, and defense SBLOs require.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {artifacts.map((item) => (
          <article class="rounded-2xl border border-slate-400/10 bg-slate-800/30 p-6">
            <h3 class="text-lg font-bold text-cream">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-300">{item.body}</p>
          </article>
        ))}
      </div>

      <div class="mt-14 overflow-hidden rounded-2xl border border-slate-400/10 bg-slate-800/30">
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="bg-slate-800/60 text-xs font-semibold uppercase tracking-wider text-slate-400">
              <tr>
                <th class="px-6 py-4">Claim</th>
                <th class="px-6 py-4">Evidence</th>
                <th class="px-6 py-4">Standard Alignment</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-400/10">
              <tr class="hover:bg-slate-700/20 transition-colors">
                <td class="px-6 py-5 text-sm font-semibold text-cream">Deterministic execution</td>
                <td class="px-6 py-5 text-sm text-slate-300">0.199 µs WCET on STM32H7</td>
                <td class="px-6 py-5 text-sm text-slate-400">DO-178C timing analysis</td>
              </tr>
              <tr class="hover:bg-slate-700/20 transition-colors">
                <td class="px-6 py-5 text-sm font-semibold text-cream">Memory safety</td>
                <td class="px-6 py-5 text-sm text-slate-300">Zero dynamic heap, no unsafe by default</td>
                <td class="px-6 py-5 text-sm text-slate-400">CISA / ONCD / NSA directives</td>
              </tr>
              <tr class="hover:bg-slate-700/20 transition-colors">
                <td class="px-6 py-5 text-sm font-semibold text-cream">Hazard mitigation</td>
                <td class="px-6 py-5 text-sm text-slate-300">Active-set polyhedral projection</td>
                <td class="px-6 py-5 text-sm text-slate-400">MIL-STD-882E</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">Target Search Intent</h2>
        <p class="mt-4 section-subheading">
          Built for FAA DER consultants, airworthiness release leads, and defense SBLOs evaluating certifiable safety software.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {keywords.map((kw) => (
          <span class="technical-badge">{kw}</span>
        ))}
      </div>

      <div class="mt-14 rounded-2xl border border-gold/20 bg-gold/5 p-8 sm:p-12">
        <h3 class="text-2xl font-bold text-cream">Build a Certifiable Safety Case</h3>
        <p class="mt-4 text-lg text-slate-300">
          Contact Atelier Logic Group LLC to review DO-178C alignment, WCET evidence, and integration options for your avionics program.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href="mailto:proposals@atelierlogicgroup.com" class="btn-primary">
            Email proposals@atelierlogicgroup.com
          </a>
          <a href="https://relulayer.ai/" class="btn-secondary">
            Explore ReluLayer™ Technical Specs
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
