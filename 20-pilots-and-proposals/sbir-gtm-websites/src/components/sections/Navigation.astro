---
const currentPath = Astro.url.pathname;
---

<!-- Top Verification & Multi-Agency Mission Alignment Bar -->
<div class="print:hidden bg-slate-900 border-b border-slate-800 text-slate-300 py-1.5 px-4 text-[11px] font-mono">
  <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 text-emerald-400 font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
        SAM.gov Active Entity
      </span>
      <span class="text-slate-600" aria-hidden="true">|</span>
      <span>UEI: <strong class="text-amber-400">G9WFN3AL69J3</strong></span>
      <span class="text-slate-600" aria-hidden="true">|</span>
      <span>CAGE: <strong class="text-white">20JX8</strong></span>
    </div>
    <div class="hidden sm:block text-slate-400">
      Mission Alignment: <span class="text-amber-400 font-bold">Enterprise Modernization • CISA Audits • Industrial Safety • Defense Autonomy</span>
    </div>
  </div>
</div>

<!-- Main Sticky Navigation Bar -->
<header class="print:hidden sticky top-0 z-50 bg-slate-950/95 backdrop-blur-md border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Corporate Logo & Legal Entity Name -->
    <a href="https://atelierlogicgroup.com/" class="flex items-center gap-3 group">
      <img
        src="/images/relulayer-mark.png"
        alt="ReluLayer™ Safety Governor Mark"
        class="h-9 w-9 object-contain shrink-0"
      />
      <div>
        <span class="font-bold text-white tracking-tight group-hover:text-amber-400 transition">
          ATELIER LOGIC GROUP LLC
        </span>
        <span class="text-[10px] block text-slate-400 uppercase tracking-widest font-mono">
          dba ReluLayer™
        </span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav aria-label="Primary" class="hidden md:flex items-center gap-6 text-xs font-medium text-slate-300">
      <a 
        href="https://atelierlogicgroup.com/" 
        aria-current={currentPath === '/' ? 'page' : undefined}
        class={`hover:text-amber-400 transition ${currentPath === '/' ? 'text-amber-400 font-semibold' : ''}`}
      >
        Corporate Hub
      </a>
      <a 
        href="https://relulayer.ai/" 
        aria-current={currentPath === '/relulayer' || currentPath === '/relulayer/' ? 'page' : undefined}
        class={`hover:text-amber-400 transition ${currentPath === '/relulayer' || currentPath === '/relulayer/' ? 'text-amber-400 font-semibold' : ''}`}
      >
        ReluLayer™ Product
      </a>
      <a 
        href="https://atelierlogicgroup.com/capability-statement/" 
        aria-current={currentPath === '/capability-statement/' || currentPath === '/capability-statement' ? 'page' : undefined}
        class={`hover:text-amber-400 transition ${currentPath === '/capability-statement/' || currentPath === '/capability-statement' ? 'text-amber-400 font-semibold' : ''}`}
      >
        Capability Statement
      </a>
      <a 
        href="https://atelierlogicgroup.com/#sblo-form" 
        class="px-4 py-2 rounded-lg bg-amber-500 text-slate-950 font-bold hover:bg-amber-400 transition shadow-md shadow-amber-500/10"
      >
        SBLO Contact
      </a>
    </nav>

  </div>
</header>