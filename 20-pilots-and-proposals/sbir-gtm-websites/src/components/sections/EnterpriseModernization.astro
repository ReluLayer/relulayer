---
const features = [
  {
    title: 'Federal Healthcare IT & Zero-Trust Interoperability',
    description: 'Secure, stateless routing of FHIR/HL7, DICOM/PACS, and edge telemetry for CMS, Medicaid, and DHA networks—strict isolation of protected data environments.',
    icon: 'heart',
  },
  {
    title: 'Legacy Codebase Refactoring (C/C++/C# to Rust)',
    description: 'We audit enterprise and defense codebase vulnerabilities and refactor mission-critical runtime modules into certifiable #![no_std] Rust for predictable, memory-safe execution.',
    icon: 'code',
  },
  {
    title: 'Deterministic MILP Optimization Engines',
    description: 'Custom Gurobi/PuLP solvers integrated into cloud CI/CD pipelines for supply chain, gate scheduling, Utilization Management, and fleet routing.',
    icon: 'chart',
  },
];

const iconPaths: Record<string, string> = {
  heart: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z',
  code: 'M16 18l6-6-6-6M8 6l-6 6 6 6',
  chart: 'M3 3v18h18M18 17V9M13 17V5M8 17v-4',
  cpu: 'M4 4h16v16H4zm4 4h8v8H8z',
};
---

<section class="relative overflow-hidden py-16 sm:py-20 lg:py-24 bg-slate-900 border-y border-slate-800">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(16,185,129,0.05),_transparent_50%)]"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">30+ Year Systems Expertise</span>
      </div>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-cream sm:text-4xl">Enterprise Modernization & Federal Health IT</h2>
      <p class="mt-4 text-lg text-slate-300">
        Leveraging memory-safe engineering, mathematical modeling, and zero-trust data architecture to modernize defense, enterprise, and federal healthcare stacks.
      </p>
    </div>

    <div class="mt-12 grid gap-8 grid-cols-1 md:grid-cols-3">
      {features.map((feature) => (
        <div class="group relative overflow-hidden rounded-2xl border border-slate-400/10 bg-slate-800/30 p-8 transition-all duration-300 hover:border-emerald-500/30 hover:bg-slate-800/50">
          <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-emerald-500/5 blur-2xl transition-colors group-hover:bg-emerald-500/10"></div>
          
          <div class="relative">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-slate-700/50 text-emerald-400 shadow-inner transition-colors group-hover:bg-emerald-500/15">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={iconPaths[feature.icon]} />
              </svg>
            </div>
            
            <h3 class="mt-6 text-xl font-bold text-cream leading-tight">{feature.title}</h3>
            
            <p class="mt-3 text-sm leading-relaxed text-slate-300">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>