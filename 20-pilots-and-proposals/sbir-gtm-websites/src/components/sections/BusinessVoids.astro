---
const voids = [
  {
    id: 'runaway',
    title: 'Runaway AI Prevention',
    description: 'Stop autonomous drones, ground robots, and vehicles from executing erratic or adversarial commands before physical wings, wheels, or motors move.',
    badge: 'Safety Governor',
    icon: 'shield',
  },
  {
    id: 'freeze',
    title: '"Never-Freeze" System Upgrades',
    description: 'Memory-safe #![no_std] Rust micro-kernels with zero dynamic heap allocation, eliminating the class of freezes, leaks, and heap fragmentation that stall legacy stacks.',
    badge: 'Zero Heap',
    icon: 'cpu',
  },
  {
    id: 'optimization',
    title: 'High-Stakes Operations Optimization',
    description: 'MILP-based fleet, gate, and resource scheduling for aviation and logistics networks—engineered to unlock tens of millions in measurable operational savings.',
    badge: 'MILP Solver',
    icon: 'graph',
  },
  {
    id: 'guardrails',
    title: 'Deterministic Mission-Logic Guardrails',
    description: 'Real-time interdiction for autonomous edge state-machines and guidance routines, ensuring flight-planning software cannot issue commands outside certifiable flight parameters.',
    badge: 'Mission Guardrail',
    icon: 'crosshair',
  },
];

const iconPaths: Record<string, string> = {
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  cpu: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2ZM9 9h6v6H9V9Z',
  graph: 'M3 3v18h18M18 17V9M13 17V5M8 17v-4',
  crosshair: 'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 6v12M6 12h12',
};
---

<section id="business-voids" class="py-20 sm:py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="section-heading">Business Voids We Solve</h2>
      <p class="mt-4 section-subheading">
        ReluLayer™ closes the gap between AI ambition and safety assurance across the four critical failure modes of autonomous systems.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {voids.map((item) => (
        <article class="group relative overflow-hidden rounded-2xl border border-slate-400/10 bg-slate-800/30 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gold/30 hover:bg-slate-800/40">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-slate-700/50 text-slate-300 transition-colors group-hover:bg-gold/15 group-hover:text-gold">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={iconPaths[item.icon]} />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-bold text-cream group-hover:text-gold transition-colors">
            {item.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">
            {item.description}
          </p>
          <div class="mt-5">
            <span class="technical-badge">{item.badge}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
