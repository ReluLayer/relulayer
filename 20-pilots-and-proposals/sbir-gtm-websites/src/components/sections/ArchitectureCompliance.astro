---
const pillars = [
  {
    id: 'memory-safe',
    title: 'CISA Memory-Safe Architecture',
    description: 'Built ground-up in',
    code: '#![no_std]',
    suffix: 'Rust to eliminate memory-corruption vulnerabilities at the hardware level.',
    icon: 'shield',
  },
  {
    id: 'deterministic',
    title: 'Deterministic Execution',
    description: 'Zero dynamic heap allocation (',
    code: 'alloc',
    suffix: '-free execution) guaranteeing zero dynamic memory latency spikes.',
    icon: 'zap',
  },
  {
    id: 'bare-metal',
    title: 'Bare-Metal Integration',
    description: 'Seamless deployment directly onto ARM Cortex-M microcontrollers and tactical embedded edge hardware.',
    code: null,
    suffix: null,
    icon: 'chip',
  },
];

const iconPaths: Record<string, string> = {
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  zap: 'M13 2 3 14h9l-1 8 10-12h-9l1-8z',
  chip: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2ZM9 9h6v6H9V9Z',
};
---

<section class="relative overflow-hidden border-y border-slate-800 bg-slate-900/50 py-16 sm:py-20 lg:py-24">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_rgba(245,158,11,0.08),_transparent_50%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,_rgba(16,185,129,0.06),_transparent_50%)]"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <!-- Left content -->
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5">
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Memory Safety by Design</span>
        </div>

        <h2 class="section-heading mt-4">Zero-Heap Memory-Safe Embedded Kernel</h2>
        <p class="mt-4 text-lg text-slate-300">
          ReluLayer is not a wrapper around unsafe legacy code. It is a ground-up deterministic kernel that removes the entire attack surface class of memory corruption from safety-critical embedded systems.
        </p>

        <div class="mt-10 space-y-6">
          {pillars.map((pillar) => (
            <div class="group flex gap-5 rounded-xl border border-slate-400/10 bg-slate-800/30 p-5 transition-all duration-300 hover:border-gold/30 hover:bg-slate-800/50">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-slate-700/50 text-gold transition-colors group-hover:bg-gold/15">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={iconPaths[pillar.icon]} />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-cream">{pillar.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-300">
                  {pillar.description}
                  {pillar.code && (
                    <code class="mx-1 rounded bg-slate-800 px-1.5 py-0.5 font-mono text-gold text-xs">{pillar.code}</code>
                  )}
                  {pillar.suffix}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right architecture diagram -->
      <div class="relative">
        <div class="absolute -inset-8 rounded-full bg-emerald-500/5 blur-3xl"></div>
        <div class="relative rounded-2xl border border-slate-400/10 bg-slate-800/40 p-6 backdrop-blur-md shadow-glass">
          <div class="mb-4 flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Kernel Architecture</span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-gold/10 px-2.5 py-1 text-xs font-semibold text-gold">
              <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
              On-Chip Only
            </span>
          </div>

          <div class="space-y-3">
            <!-- Layer 1: Client / AI Planner -->
            <div class="relative overflow-hidden rounded-lg border border-slate-400/10 bg-slate-900/60 p-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="flex h-8 w-8 items-center justify-center rounded bg-slate-700/50 text-slate-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5" />
                      <path d="M8.5 8.5v.01" />
                      <path d="M16 15.5v.01" />
                      <path d="M12 10v.01" />
                    </svg>
                  </div>
                  <div>
                    <div class="text-sm font-semibold text-cream">Client AI / Guidance Planner</div>
                    <div class="text-xs text-slate-400">Probabilistic trajectory candidate</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Arrow -->
            <div class="flex justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400">
                <path d="M12 5v14" />
                <path d="m19 12-7 7-7-7" />
              </svg>
            </div>

            <!-- Layer 2: ReluLayer Kernel -->
            <div class="relative overflow-hidden rounded-lg border border-gold/30 bg-gold/5 p-4 shadow-gold-glow">
              <div class="absolute -right-4 -top-4 h-20 w-20 rounded-full bg-gold/20 blur-xl"></div>
              <div class="relative flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gold/15 text-gold">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                  </div>
                  <div>
                    <div class="text-base font-bold text-cream">ReluLayer™ Safety Kernel</div>
                    <div class="text-xs font-mono text-gold">0.199 µs · zero heap · deterministic</div>
                  </div>
                </div>
                <div class="hidden rounded bg-slate-900/60 px-2 py-1 text-xs font-mono text-slate-400 sm:block">
                  <span class="text-purple-400">#![no_std]</span>
                </div>
              </div>
            </div>

            <!-- Arrow -->
            <div class="flex justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400">
                <path d="M12 5v14" />
                <path d="m19 12-7 7-7-7" />
              </svg>
            </div>

            <!-- Layer 3: Hardware -->
            <div class="relative overflow-hidden rounded-lg border border-slate-400/10 bg-slate-900/60 p-4">
              <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded bg-slate-700/50 text-emerald-400">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2ZM9 9h6v6H9V9Z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-cream">ARM Cortex-M / STM32H7</div>
                  <div class="text-xs text-slate-400">480 MHz bare-metal silicon</div>
                </div>
              </div>
            </div>
          </div>

          <!-- No-heap barrier -->
          <div class="mt-4 flex items-center justify-center gap-2 rounded-lg border border-dashed border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400">
              <circle cx="12" cy="12" r="10" />
              <path d="m15 9-6 6" />
              <path d="m9 9 6 6" />
            </svg>
            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">No Heap Allocation · No malloc · No Garbage Collection</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
