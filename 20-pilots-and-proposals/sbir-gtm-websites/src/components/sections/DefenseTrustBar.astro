---
const trustItems = [
  { label: 'CAGE', value: '20JX8', caption: 'SAM.gov Verified' },
  { label: 'UEI', value: 'G9WFN3AL69J3', caption: 'Active Entity' },
  { label: 'NAICS', value: '541715 · 541511 · 518210 · 541330 · 541512', caption: 'R&D, Programming, Data Processing, Engineering, IT' },
  { label: 'Facility', value: 'Kenner, LA', caption: '32 Normandy Dr.' },
  { label: 'SBA', value: 'Small Business', caption: 'Self-Certified' },
];
---

<section class="border-y border-slate-400/10 bg-navy-100/50" aria-label="Defense verification credentials">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {trustItems.map((item) => (
        <div class="flex flex-col rounded-lg border border-slate-400/10 bg-navy-300/50 px-4 py-3">
          <span class="text-xs font-mono uppercase tracking-wider text-slate-400">{item.label}</span>
          <span class="mt-1 text-sm font-semibold text-cream">{item.value}</span>
          <span class="mt-0.5 text-xs text-slate-400">{item.caption}</span>
        </div>
      ))}
    </div>
  </div>
</section>
