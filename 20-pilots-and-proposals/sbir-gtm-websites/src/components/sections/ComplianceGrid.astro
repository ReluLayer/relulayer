---
const columns = [
  {
    title: 'Tier 1 Performance Metrics',
    icon: 'zap',
    items: [
      { label: 'WCET', value: '0.199 µs' },
      { label: 'Speed Advantage', value: '~5,000x vs Cloud' },
      { label: 'Footprint', value: '326 Bytes' },
      { label: 'HIL Variance', value: '0.00% across 5,000 passes' },
    ],
  },
  {
    title: 'ACCSE™ Tier 2 — Swarm Intelligence',
    icon: 'crosshair',
    items: [
      { label: 'Greedy Centrality', value: '10.7 ms · 123 KB · 0.9993 ARI' },
      { label: 'Hungarian Target Allocation', value: '27.9 µs · 97.08% optimality' },
      { label: 'Contested EW State Machine', value: 'Evidential Dirichlet Filter — Active when α < 0.30; Passive when α ≥ 0.30' },
    ],
  },
  {
    title: 'Compliance & Safety',
    icon: 'shield',
    items: [
      { label: 'Memory Safety', value: 'CISA Memory-Safe' },
      { label: 'Aviation', value: 'RTCA DO-178C DAL A' },
      { label: 'Risk', value: 'MIL-STD-882E' },
      { label: 'Heap', value: 'Zero Dynamic Allocation' },
      { label: 'Contested C2 & EW Kinematic Protection', value: 'Bare-metal #![no_std] Rust kernel operates entirely on-chip, maintaining deterministic flight envelope enforcement during total RF jamming, SATCOM loss (e.g., Starlink blinding), or primary C2 link degradation.' },
    ],
  },
  {
    title: 'Government Identifiers',
    icon: 'id',
    items: [
      { label: 'UEI', value: 'G9WFN3AL69J3' },
      { label: 'CAGE', value: '20JX8' },
      { label: 'Primary NAICS', value: '541715 · 541511 · 518210' },
      { label: 'Key PSCs', value: 'AC11 · AC12 · DA01 · D302' },
    ],
  },
  {
    title: 'IP Portfolio',
    icon: 'file',
    items: [
      { label: 'Patent Pending', value: 'USPTO Serial No. 64/127,611' },
      { label: 'Attorney Docket', value: 'RELU-001-PPA7 (filed Aug 7, 2026)' },
      { label: 'Continuity', value: 'Provisionals I–VI (64/021,087 through 64/124,094)' },
      { label: 'Inventor', value: 'Ishmael Ibrahim Amin, M.S.' },
      { label: 'Status', value: 'Active Prosecution' },
      { label: 'Jurisdiction', value: 'United States' },
    ],
  },
  {
    title: 'EU AI Act (EU 2024/1689)',
    icon: 'shield',
    items: [
      { label: 'Classification', value: 'Safety Component of Product (Annex I / Machinery / Aviation)' },
      { label: 'Defense Status', value: 'Article 2(3) Military Exemption Support' },
      { label: 'Risk Mitigation', value: 'Bounded Deterministic Override', image: true },
      { label: 'Enforcement Readiness', value: '2026–2028 Phased Compliance Ready' },
    ],
  },
];

const iconPaths: Record<string, string> = {
  zap: 'M13 2 3 14h9l-1 8 10-12h-9l1-8z',
  crosshair: 'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 6v12M6 12h12',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  id: 'M4 4h16v16H4z M8 8h8M8 12h5M8 16h3',
  file: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8',
};

---

<section id="compliance" class="py-20 sm:py-24 lg:py-32 bg-navy-100/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="section-heading">Deep-Tech & Defense Compliance Grid</h2>
      <p class="mt-4 section-subheading">
        Verified performance, memory-safety compliance, and government identifiers ready for defense contracting and OEM due diligence.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        <span class="inline-flex items-center rounded-full bg-slate-800/80 px-3 py-1 text-xs font-medium text-slate-300 border border-slate-700/80">OMB M-24-10 Federal AI Risk Mitigation</span>
        <span class="inline-flex items-center rounded-full bg-slate-800/80 px-3 py-1 text-xs font-medium text-slate-300 border border-slate-700/80">ASTM F3269-17 Bound-Based RTA</span>
        <span class="inline-flex items-center rounded-full bg-slate-800/80 px-3 py-1 text-xs font-medium text-slate-300 border border-slate-700/80">NIST SP 800-218 (SSDF) / OMB M-22-18 Ready</span>
        <span class="inline-flex items-center rounded-full bg-slate-800/80 px-3 py-1 text-xs font-medium text-slate-300 border border-slate-700/80">NHTSA SGO / ISO 26262 ASIL-D Safe-State</span>
        <span class="inline-flex items-center rounded-full bg-slate-800/80 px-3 py-1 text-xs font-medium text-slate-300 border border-slate-700/80">EU AI Act (EU 2024/1689) Safety Component</span>
      </div>
    </div>

    <div class="mt-14 grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
      {columns.map((col) => (
        <div class="rounded-2xl border border-slate-400/10 bg-slate-800/30 p-6">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-700/50 text-gold">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={iconPaths[col.icon]} />
              </svg>
            </div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-cream">{col.title}</h3>
          </div>

          <ul class="mt-6 space-y-4">
            {col.items.map((item) => (
              <li class="border-b border-slate-400/10 pb-3 last:border-0 last:pb-0">
                <p class="text-[11px] font-mono uppercase tracking-wider text-slate-400">{item.label}</p>
                <p class="mt-0.5 text-sm font-semibold text-cream">
                  {item.value}
                  {item.image && (
                    <span class="font-mono text-amber-400 font-semibold ml-1">S<sub>v</sub></span>
                  )}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {/* Us vs. Them Compliance Matrix */}
    <div class="mt-20 rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-800">
        <h3 class="text-lg font-bold text-cream">The Procurement Reality: ReluLayer™ vs. Legacy C/C++ (ROS2)</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-800/50 text-slate-300">
            <tr>
              <th class="px-6 py-4 font-semibold">Evaluation Criteria</th>
              <th class="px-6 py-4 font-semibold text-emerald-400 border-l border-slate-800">ReluLayer™</th>
              <th class="px-6 py-4 font-semibold text-red-400 border-l border-slate-800">Legacy C/C++ (ROS2)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <tr class="hover:bg-slate-800/20 transition-colors">
              <td class="px-6 py-4 font-medium text-slate-300">CISA Memory-Safety Mandate</td>
              <td class="px-6 py-4 border-l border-slate-800 bg-emerald-950/10 text-emerald-400 font-medium">100% Compliant (#![no_std] Rust)</td>
              <td class="px-6 py-4 border-l border-slate-800 bg-red-950/10 text-red-400 font-medium">Non-Compliant (Requires DoD Waivers)</td>
            </tr>
            <tr class="hover:bg-slate-800/20 transition-colors">
              <td class="px-6 py-4 font-medium text-slate-300">Dynamic Heap Allocation</td>
              <td class="px-6 py-4 border-l border-slate-800 bg-emerald-950/10 text-emerald-400 font-medium">Zero (alloc-free)</td>
              <td class="px-6 py-4 border-l border-slate-800 bg-red-950/10 text-red-400 font-medium">High Risk (Memory Leaks/Buffer Overflows)</td>
            </tr>
            <tr class="hover:bg-slate-800/20 transition-colors">
              <td class="px-6 py-4 font-medium text-slate-300">Execution Determinism</td>
              <td class="px-6 py-4 border-l border-slate-800 bg-emerald-950/10 text-emerald-400 font-medium">Mathematically Bounded (0.199 µs WCET)</td>
              <td class="px-6 py-4 border-l border-slate-800 bg-red-950/10 text-red-400 font-medium">Non-Deterministic (Jitter Spikes)</td>
            </tr>
            <tr class="hover:bg-slate-800/20 transition-colors">
              <td class="px-6 py-4 font-medium text-slate-300">Defense Procurement Risk (2027+)</td>
              <td class="px-6 py-4 border-l border-slate-800 bg-emerald-950/10 text-emerald-400 font-medium">Zero Liability / Turnkey SSDF</td>
              <td class="px-6 py-4 border-l border-slate-800 bg-red-950/10 text-red-400 font-medium">High Risk of Contract Disqualification</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
