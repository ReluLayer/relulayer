---
const audits = [
  {
    id: 'rtos-determinism',
    title: 'Standard RTOS vs. ReluLayer™ Determinism Gap',
    icon: 'activity',
    problem: 'Standard embedded C/C++ or RTOS frameworks rely on dynamic heap allocation (<code class="rounded bg-slate-800 px-1 py-0.5 font-mono text-slate-200">malloc</code>/<code class="rounded bg-slate-800 px-1 py-0.5 font-mono text-slate-200">free</code>). Under heavy sensor loads or corrupted RF packets, heap fragmentation causes unpredictable execution latency spikes (>10 ms jitter), leading to lost control frames and kinetic safety breaches.',
    solution: 'ReluLayer™ eliminates the heap entirely. The same worst-case path executes in a flat, deterministic <strong class="text-gold">0.199 µs</strong> on every invocation.',
    metrics: [
      { label: 'Standard RTOS Jitter', value: '>10 ms', note: 'spikes to 50 ms' },
      { label: 'ReluLayer™ WCET', value: '0.199 µs', note: 'sub-microsecond' },
    ],
  },
  {
    id: 'zero-heap-ew',
    title: 'Zero-Heap CISA Memory Safety Under EW Attack',
    icon: 'shield',
    problem: 'When Electronic Warfare (EW) or RF jamming corrupts memory packets at the physical layer, traditional code risks buffer overflows, dynamic memory exhaustion, or undefined behavior.',
    solution: 'ReluLayer™ is built ground-up in <code class="rounded bg-slate-800 px-1 py-0.5 font-mono text-gold">#![no_std]</code> Rust with zero dynamic heap allocation. The attack surface class of memory-corruption vulnerabilities is removed at compile time.',
    metrics: [
      { label: 'Dynamic Heap Allocated', value: '0 Bytes', note: 'no malloc / free' },
      { label: 'HIL Violation Rate', value: '0.00%', note: '5,000+ stress passes' },
    ],
  },
  {
    id: 'accse-c2-loss',
    title: 'ACCSE™ Swarm Splitting During Total C2 Loss',
    icon: 'network',
    problem: 'Simulated 100% SATCOM and RF C2 blackout severs centralized command. Without decentralized fallback, swarm cohesion collapses and inter-vehicle safety envelopes are breached.',
    solution: 'ACCSE™ executes real-time DTMDP swarm splitting and dynamic target allocation. Friendly agents autonomously reorganize into safe sub-formations while ReluLayer™ enforces kinetic boundaries locally on every node.',
    metrics: [
      { label: 'C2 Link Degradation', value: '100%', note: 'total RF blackout' },
      { label: 'Kinetic Boundary Safety', value: 'Maintained', note: 'zero C2 dependency' },
    ],
  },
];

const iconPaths: Record<string, string> = {
  activity: 'M22 12h-4l-3 9L9 3l-3 9H2',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  network: 'M5 16V9h14v7M12 2v20',
};
---

<section class="relative overflow-hidden border-y border-slate-800 bg-slate-900/50 py-16 sm:py-20 lg:py-24">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(245,158,11,0.08),_transparent_50%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(16,185,129,0.06),_transparent_50%)]"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Technical Audit Benchmarks</span>
      </div>
      <h2 class="section-heading mt-4">Problem / Solution / Proof</h2>
      <p class="mt-4 section-subheading">
        Empirical baseline metrics showing why deterministic memory-safety and decentralized swarm governance matter in contested RF environments.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {audits.map((audit) => (
        <article class="group relative overflow-hidden rounded-2xl border border-slate-400/10 bg-slate-800/30 p-6 transition-all duration-300 hover:border-gold/30 hover:bg-slate-800/50">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-700/50 text-gold transition-colors group-hover:bg-gold/15">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={iconPaths[audit.icon]} />
              </svg>
            </div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-cream">{audit.title}</h3>
          </div>

          <div class="mt-6 space-y-4">
            <div class="rounded-lg border border-red-400/20 bg-red-400/5 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-red-400">The Problem</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-300" set:html={audit.problem} />
            </div>
            <div class="rounded-lg border border-gold/20 bg-gold/5 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-gold">The ReluLayer™ Solution</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-300" set:html={audit.solution} />
            </div>
          </div>

          <div class="mt-6 grid grid-cols-2 gap-3">
            {audit.metrics.map((metric) => (
              <div class="rounded-lg border border-slate-400/10 bg-slate-900/50 p-3 text-center">
                <p class="text-[10px] font-mono uppercase tracking-wider text-slate-400">{metric.label}</p>
                <p class="mt-1 text-xl font-bold font-mono text-cream">{metric.value}</p>
                <p class="text-xs text-slate-400">{metric.note}</p>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
